{
  "regions": ["icn1"],
  "functions": {
    "api/dart.js": { "maxDuration": 60 },
    "api/dart-feed.js": { "maxDuration": 60 },
    "api/enriched.js": { "maxDuration": 60 },
    "api/context.js": { "maxDuration": 60 },
    "api/signals.js": { "maxDuration": 60 },
    "api/news.js": { "maxDuration": 60 },
    "api/briefing.js": { "maxDuration": 60 },
    "api/kvic.js": { "maxDuration": 60 },
    "api/kvic-backfill.js": { "maxDuration": 60 },
    "api/ontology.js": { "maxDuration": 60 },
    "api/entity.js": { "maxDuration": 60 },
    "api/writer.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/motae", "destination": "/api/kvic?mode=dashboard" },
    { "source": "/api/vcs-notices", "destination": "/api/kvic?mode=vcs" }
  ],
  "crons": [
    { "path": "/api/kvic-backfill?auto=historical&pages=3&fromYear=2020&pdf=selection", "schedule": "10 20 * * *" },
    { "path": "/api/enriched?days=1", "schedule": "50 21 * * *" },
    { "path": "/api/news?feed=calendar", "schedule": "15 23 * * *" }
  ],
  "headers": [{
    "source": "/auth/:path*",
    "headers": [
      {"key":"Cache-Control","value":"no-store, max-age=0"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"X-Frame-Options","value":"DENY"},
      {"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'"}
    ]
  }]
}
