{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "builds": [
    {
      "src": "maintenance/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/.*",
      "dest": "/maintenance/index.html",
      "status": 503,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow",
        "Retry-After": "86400"
      }
    }
  ],
  "crons": [],
  "git": {
    "deploymentEnabled": false
  }
}
